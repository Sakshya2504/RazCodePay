# Local demo defaults — no database or provider secrets are required to view the console.
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGIN=http://localhost:5173
DEMO_MODE=true

# Optional persistence
MONGODB_URI=mongodb://127.0.0.1:27017/razcodepay

# Optional Razorpay integration (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional LLM reasoning — local AI remains available without this key.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
