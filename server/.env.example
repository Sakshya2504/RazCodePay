# API
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGIN=http://127.0.0.1:5173
DEMO_MODE=true

# MongoDB — required when DEMO_MODE=false
MONGODB_URI=mongodb://127.0.0.1:27017/razcodepay

# Redis/BullMQ — required for production background jobs
REDIS_URL=redis://127.0.0.1:6379

# Authentication / encryption — generate long random values for production
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# Razorpay direct API fallback
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay Technology Partner OAuth
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
RAZORPAY_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/razorpay/oauth/callback

# Optional LLM reasoning
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Customer email delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=RazCodePay <no-reply@example.com>
