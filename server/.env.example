# API
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGIN=http://127.0.0.1:5173
DEMO_MODE=true

# MongoDB — required when DEMO_MODE=false
MONGODB_URI=mongodb://127.0.0.1:27017/razcodepay

# Authentication / encryption — generate long random values for production
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-long-random-encryption-key

# Optional Razorpay platform fallback (demo or single-merchant deployments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional LLM reasoning
AI_API_KEY=
AI_MODEL=gpt-4o-mini
